# Project Settings → API in Supabase. This key is public by design; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Empty for local development or a user/organization GitHub Pages site.
# For a repository site, use /repository-name. The workflow sets this automatically.
NEXT_PUBLIC_BASE_PATH=
